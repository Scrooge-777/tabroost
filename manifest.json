{
  "manifest_version": 3,
  "name": "Workspaces",
  "version": "0.2.0",
  "key": "",
  "description": "Edge-style workspaces and persistent tab groups.",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "favicon",
    "contextMenus",
    "sessions"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/accent-border.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Workspaces",
    "default_popup": "src/sidepanel/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "commands": {
    "open-switcher": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open workspace switcher"
    },
    "new-workspace": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "New workspace"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel/*",
        "src/sidepanel/components/*",
        "src/shared/*",
        "assets/*",
        "assets/icons/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
